{
  "$schema": "https://mintlify.com/docs.json",
  "name": "StaffGlimpse",
  "theme": "luma",
  "colors": {
    "primary": "#0F52BA",
    "light": "#2563EB",
    "dark": "#3B82F6"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://staffglimpse.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "docs/introduction",
              "docs/quickstart",
              "docs/authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "docs/concepts/multi-tenancy",
              "docs/concepts/roles-permissions",
              "docs/concepts/response-format"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "docs/guides/company-setup",
              "docs/guides/user-management",
              "docs/guides/attendance",
              "docs/guides/leave-management",
              "docs/guides/documents"
            ]
          },
          {
            "group": "Base URLs & Endpoints",
            "pages": [
              "docs/endpoints/overview"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Company & Org",
            "pages": [
              "api-reference/company",
              "api-reference/departments",
              "api-reference/roles"
            ]
          },
          {
            "group": "Users",
            "pages": [
              "api-reference/users",
              "api-reference/metadata"
            ]
          },
          {
            "group": "Workforce",
            "pages": [
              "api-reference/attendance",
              "api-reference/leave-policies",
              "api-reference/leave-requests"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "api-reference/messages",
              "api-reference/documents"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.json"
  }
}
